<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        Журнал надісланих нагадувань. Унікальний appointment_id гарантує,
        що нагадування про один прийом ніколи не буде записане двічі,
        тобто повторний запуск завдання нічого не змінює (ідемпотентність).
        При видаленні запису на прийом рядок журналу видаляється каскадом.
    -->
    <changeSet id="010-create-appointment-reminder-table" author="clinic">
        <createTable tableName="appointment_reminder">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="appointment_id" type="BIGINT">
                <constraints nullable="false"
                             unique="true" uniqueConstraintName="uk_reminder_appointment"
                             foreignKeyName="fk_reminder_appointment"
                             references="appointment(id)" deleteCascade="true"/>
            </column>
            <column name="sent_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
